server backend {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

database postgres {
    engine = "postgresql";
    version = "16";
    port = 5432;
}

service api {
    port = 8080;
    replicas = 2;
    dependsOn = [postgres];
}

function enoughMemory(server s, int minimum) bool {
    return s.memory >= minimum;
}

task production {
    start(postgres);
    start(backend);
    install(backend, "docker");

    if (enoughMemory(backend, 8)) {
        deploy(backend, api);
        scale(api, 3);
    }
}

main {
    run production;
}
