server servidorBasico {
    cpu = 2;
    memory = 4;
    disk = 50;
    os = "ubuntu";
}

server servidorPaquetes {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

server servidorDespliegue {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

server servidorTareas {
    cpu = 2;
    memory = 4;
    disk = 50;
    os = "ubuntu";
}

server servidorDependencias {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

server servidorAcciones {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

server servidorLectura {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

server servidorSecuencia {
    cpu = 8;
    memory = 16;
    disk = 200;
    os = "ubuntu";
}

server servidorExpresiones {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}

database datosBase {
    engine = "postgresql";
    version = "16";
    port = 5432;
}

database datosDependencia {
    engine = "postgresql";
    version = "16";
    port = 5433;
}

database datosAcciones {
    engine = "mysql";
    version = "16";
    port = 3306;
}

database datosLectura {
    engine = "postgresql";
    version = "16";
    port = 5434;
}

database datosSecuencia {
    engine = "postgresql";
    version = "16";
    port = 5435;
}

service servicioBasico {
    port = 8080;
    replicas = 1;
}

service servicioDespliegue {
    port = 8081;
    replicas = 2;
}

service servicioDependencias {
    port = 8082;
    replicas = 2;
dependsOn = [datosDependencia];
}

service servicioAcciones {
    port = 8083;
    replicas = 1;
}

service servicioLectura {
    port = 8084;
    replicas = 2;
dependsOn = [datosLectura];
}

service servicioSecuencia {
    port = 8085;
    replicas = 2;
dependsOn = [datosSecuencia];
}

// Variables globales usadas por funciones, tareas y pruebas de alcance.
int datoGlobal = 10;
int visitasCortoCircuito = 0;
int pasosTarea = 0;
int resultadoTarea = 0;
string trazaTareas = "";
string[] paquetesGlobales = ["docker", "git", "nginx"];

function sumar(int a, int b) int {
    return a + b;
}

function mitad(float valor) float {
    return valor / 2;
}

function elegir(bool habilitado, int valor) int {
    if (habilitado) {
        return valor;
    }
    return 0;
}

function capacidad(server equipo, int minimo) bool {
    return equipo.memory >= minimo;
}

function sumarArreglo(int[] numeros) int {
    int acumulado = 0;
    for (int posicion = 0; posicion < length(numeros); posicion = posicion + 1) {
        acumulado = acumulado + numeros[posicion];
    }
    return acumulado;
}

function leerGlobal() int {
    return datoGlobal;
}

function alcanceLocal(int datoGlobal) int {
    int resultado = datoGlobal;
    if (true) {
        int datoGlobal = 30;
        resultado = resultado + datoGlobal;
    }
    return resultado + datoGlobal + leerGlobal();
}

function registrarVisita() bool {
    visitasCortoCircuito = visitasCortoCircuito + 1;
    return true;
}

function constante() int {
    return 42;
}

function bandera() bool {
    return true;
}

function doble(int numero) int {
    return numero * 2;
}

function alcanza(int numero, int minimo) bool {
    return numero >= minimo;
}

function factorial(int numero) int {
    if (numero <= 1) {
        return 1;
    }
    return numero * factorial(numero - 1);
}

function sumaRecursiva(int numero) int {
    if (numero <= 0) {
        return 0;
    }
    return numero + sumaRecursiva(numero - 1);
}

function cuentaRegresiva(int numero) bool {
    if (numero == 0) {
        return true;
    }
    return cuentaRegresiva(numero - 1);
}

// Las tareas no reciben parametros. Se invocan solamente mediante run.
task prepararTarea {
    start(servidorTareas);
    pasosTarea = pasosTarea + 1;
    trazaTareas = trazaTareas + "preparar;";
}

task completarTarea {
    install(servidorTareas, "git");
    resultadoTarea = sumar(2, 3);
    pasosTarea = pasosTarea + 1;
    trazaTareas = trazaTareas + "completar;";
}

main {
