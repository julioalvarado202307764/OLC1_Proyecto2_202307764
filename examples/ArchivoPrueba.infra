        aprobadas = aprobadas + 1;
    }
    print("Estados observados entre acciones de paquetes | cumple=" + cumpleSecuenciaPaquetes + " | puntos=" + ganadoSecuenciaPaquetes + "/2");

    start(datosSecuencia);
    deploy(servidorSecuencia, servicioSecuencia);
    int replicasAntes = servicioSecuencia.replicas;
    scale(servicioSecuencia, 5);
    int replicasDespues = servicioSecuencia.replicas;
    bool cumpleSecuenciaDespliegue = replicasAntes == 2 && replicasDespues == 5 && servicioSecuencia.host == servidorSecuencia && servicioSecuencia.status == "running";
    float ganadoSecuenciaDespliegue = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleSecuenciaDespliegue) {
        ganadoSecuenciaDespliegue = 3.0;
        puntosAvanzado = puntosAvanzado + ganadoSecuenciaDespliegue;
        aprobadas = aprobadas + 1;
    }
    print("Deploy seguido de scale conserva y actualiza datos | cumple=" + cumpleSecuenciaDespliegue + " | puntos=" + ganadoSecuenciaDespliegue + "/3");

    stop(servicioSecuencia);
    string estadoDetenido = servicioSecuencia.status;
    start(servicioSecuencia);
    string estadoReanudado = servicioSecuencia.status;
    bool cumpleSecuenciaEstados = estadoDetenido == "stopped" && estadoReanudado == "running";
    float ganadoSecuenciaEstados = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleSecuenciaEstados) {
        ganadoSecuenciaEstados = 2.0;
        puntosAvanzado = puntosAvanzado + ganadoSecuenciaEstados;
        aprobadas = aprobadas + 1;
    }
    print("Stop y start de un servicio ya desplegado | cumple=" + cumpleSecuenciaEstados + " | puntos=" + ganadoSecuenciaEstados + "/2");

    // Funciones recursivas: llamadas, caso base y retorno - 6 puntos.
    bool cumpleRecursionBase = factorial(0) == 1 && factorial(1) == 1;
    float ganadoRecursionBase = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleRecursionBase) {
        ganadoRecursionBase = 1.0;
        puntosAvanzado = puntosAvanzado + ganadoRecursionBase;
        aprobadas = aprobadas + 1;
    }
    print("Casos base de recursion | cumple=" + cumpleRecursionBase + " | puntos=" + ganadoRecursionBase + "/1");

    bool cumpleRecursionFactorial = factorial(5) == 120;
    float ganadoRecursionFactorial = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleRecursionFactorial) {
        ganadoRecursionFactorial = 2.0;
        puntosAvanzado = puntosAvanzado + ganadoRecursionFactorial;
        aprobadas = aprobadas + 1;
    }
    print("Factorial recursivo | cumple=" + cumpleRecursionFactorial + " | puntos=" + ganadoRecursionFactorial + "/2");

    bool cumpleRecursionSuma = sumaRecursiva(5) == 15 && sumaRecursiva(3) == 6;
    float ganadoRecursionSuma = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleRecursionSuma) {
        ganadoRecursionSuma = 2.0;
        puntosAvanzado = puntosAvanzado + ganadoRecursionSuma;
        aprobadas = aprobadas + 1;
    }
    print("Recursion con acumulacion y llamadas independientes | cumple=" + cumpleRecursionSuma + " | puntos=" + ganadoRecursionSuma + "/2");

    bool cumpleRecursionBool = cuentaRegresiva(4);
    float ganadoRecursionBool = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleRecursionBool) {
        ganadoRecursionBool = 1.0;
        puntosAvanzado = puntosAvanzado + ganadoRecursionBool;
        aprobadas = aprobadas + 1;
    }
    print("Recursion con retorno bool | cumple=" + cumpleRecursionBool + " | puntos=" + ganadoRecursionBool + "/1");

    // Expresiones compuestas, funciones anidadas y acceso a arreglos - 6.5 puntos.
    start(servidorExpresiones);
    bool cumpleLlamadasAnidadas = alcanza(doble(sumar(2, 2)), 8);
    float ganadoLlamadasAnidadas = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleLlamadasAnidadas) {
        ganadoLlamadasAnidadas = 2.0;
        puntosAvanzado = puntosAvanzado + ganadoLlamadasAnidadas;
        aprobadas = aprobadas + 1;
    }
    print("Llamadas de funciones dentro de otras llamadas | cumple=" + cumpleLlamadasAnidadas + " | puntos=" + ganadoLlamadasAnidadas + "/2");

    bool expresionCompleja = (servidorExpresiones.cpu * 2 + servidorExpresiones.memory >= 16) && (servidorExpresiones.status == "running" || false) && !(servidorExpresiones.disk < 100);
    bool cumpleExpresionCompuesta = expresionCompleja;
    float ganadoExpresionCompuesta = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleExpresionCompuesta) {
        ganadoExpresionCompuesta = 2.0;
        puntosAvanzado = puntosAvanzado + ganadoExpresionCompuesta;
        aprobadas = aprobadas + 1;
    }
    print("Expresion aritmetica, relacional y logica compuesta | cumple=" + cumpleExpresionCompuesta + " | puntos=" + ganadoExpresionCompuesta + "/2");

    string paqueteElegido = paquetesGlobales[sumar(0, 1)];
    bool instaloCompuesto = install(servidorExpresiones, paqueteElegido);
    bool cumpleArregloConFuncion = paqueteElegido == "git" && instaloCompuesto && length(servidorExpresiones.packages) == 1 && servidorExpresiones.packages[0] == "git";
    float ganadoArregloConFuncion = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleArregloConFuncion) {
        ganadoArregloConFuncion = 1.5;
        puntosAvanzado = puntosAvanzado + ganadoArregloConFuncion;
        aprobadas = aprobadas + 1;
    }
    print("Funcion como indice y elemento como argumento nativo | cumple=" + cumpleArregloConFuncion + " | puntos=" + ganadoArregloConFuncion + "/1.5");

    bool cumpleNativasEnExpresion = alcanza(length(servidorExpresiones.packages), 1) && status(servidorExpresiones) == "running" && paquetesGlobales[length(paquetesGlobales) - 1] == "nginx";
    float ganadoNativasEnExpresion = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumpleNativasEnExpresion) {
        ganadoNativasEnExpresion = 1.0;
        puntosAvanzado = puntosAvanzado + ganadoNativasEnExpresion;
        aprobadas = aprobadas + 1;
    }
    print("Nativas, propiedades e indices en una expresion | cumple=" + cumpleNativasEnExpresion + " | puntos=" + ganadoNativasEnExpresion + "/1");

    print("SUBTOTAL AVANZADO FUNCIONAL: " + puntosAvanzado + "/39");
    // La continuidad no demuestra que el lexer haya REGISTRADO los errores.
    // Por eso no se suman automaticamente los 3.5 puntos del reporte lexico.
    bool continuidadCompleta = continuidadesLexicas == 3;
    float puntosAutomaticos = puntosBasico + puntosIntermedio + puntosAvanzado;
    print("================================================");
    print("RESUMEN DE LA PRUEBA");
    print("Basico: " + puntosBasico + "/10");
    print("Intermedio: " + puntosIntermedio + "/30");
    print("Avanzado funcional: " + puntosAvanzado + "/39");
    print("PUNTAJE AUTOMATICO: " + puntosAutomaticos + "/79");
    print("Comprobaciones aprobadas: " + aprobadas + "/" + comprobaciones);
    print("Continuidad tras los 3 caracteres aislados: " + continuidadCompleta);
    print("Errores lexicos: 3.5 puntos PENDIENTES de revision externa.");
    print("Errores sintacticos: 4.5 puntos NO EVALUADOS en este archivo.");
    print("Reportes: 8 puntos y gramatica: 5 puntos de revision externa.");
    print("Connect/disconnect: confirmar los efectos en la bitacora.");
    print("No se aplican penalizaciones automaticamente.");
    print("FIN_AUTOINFRA");
    print("================================================");
}
